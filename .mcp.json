{
  "mcpServers": {
    "rhinoceros3d": {
      "command": "uvx",
      "args": [
        "rhinomcp",
        "--port",
        "1999"
      ]
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1"
      }
    },
    "memory_machine": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
      "args": [
        "${CLAUDE_PROJECT_DIR}/mcp_server.py"
      ],
      "env": {}
    }
  }
}