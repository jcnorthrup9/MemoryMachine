{
  "mcpServers": {
    "rhinoceros3d": {
      "command": "uvx",
      "args": ["rhinomcp", "--port", "1999"]
    },
    "memory_machine": {
      "command": "python",
      "args": ["d:/MemoryMachine/mcp_server.py"]
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "BLENDER_HOST": "127.0.0.1"
      }
    }
  }
}
