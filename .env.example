# ── Blender Demo Mode ─────────────────────────────────────────────────────────
# Path to blender.exe — leave blank to auto-detect from common install locations
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe

# Path to the Pershing Square generator script
GENERATOR_SCRIPT_PATH=D:\MemoryMachine\pershing_square_generator.py

# Where headless Blender writes STL output (served at /blender-output/)
BLENDER_OUTPUT_DIR=D:\MemoryMachine\output\blender
