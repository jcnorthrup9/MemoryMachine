# ── Blender Demo Mode ─────────────────────────────────────────────────────────
# Path to blender.exe — leave blank/unset to auto-detect from common install locations.
# Machine-specific; set this per machine, don't rely on a synced value.
BLENDER_PATH=

# Optional overrides — defaults are computed relative to the repo root
# (see logic/blender_demo.py), leave unset unless you need to point elsewhere.
#GENERATOR_SCRIPT_PATH=
#BLENDER_OUTPUT_DIR=
