# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

__pycache__/
cache/

# Ignore environment variables (API Keys) -- *.env also catches sync-conflict
# copies (.env.example is a template with no real values, still tracked)
*.env

# Ignore virtual environments
.venv/
venv/
env/

# Ignore generated files
html/presentation_deck.html

# Ignore scraper results, which can be large
scrapfly-scrapers/tripadvisor-scraper/results/
scrapfly-scrapers/linkedin-scraper/results/
scrapfly-scrapers/g2-scraper/results/
scrapfly-scrapers/youtube-scraper/results/

# Ignore large data files
data/

# Regenerable derived output -- diagram exports, vector-DB index files,
# generated 3D assets, and Blender/render test output. Not source, shouldn't
# live in git history (the generated diagram exports alone already account
# for multiple GB). outputs/cockpit/ is NOT included here -- blender_cockpit.py
# actually loads outputs/cockpit/sketch_weights_cache.json at import time.
archive/diagrams/generated/
archive/diagrams/generated.zip
archive/diagrams/generatedDiagramsColor/
db/
# Demo Mode headless-Blender STL runs -- formerly the top-level output/blender/
# folder, merged into outputs/ (2026-07-30) to stop having two lookalike
# output roots. Same "regenerable test output" reasoning as output/ was.
outputs/blender/
outputs/vector_export_test/
outputs/stylized_export_test/
outputs/drawings_export/
# Headless-Blender build test runs (2026-07-24) -- one .obj/.mtl pair per
# job_id, regenerated on every "Build in Blender" click during testing;
# ballooned to 1.2GB+ uncommitted. outputs/pershing_archive/ (real saved
# build iterations, ArchivePanel.jsx) is NOT included here -- distinct
# from this throwaway test-build output.
outputs/blender_headless/
# Rhino .3dm export test artifacts (2026-07-24) -- individual files can
# exceed GitHub's 50MB recommended max (flagged on push); same "not
# source, regenerable" reasoning as outputs/blender_headless/ above.
outputs/rhino/
# Loose debug-capture files dropped directly in outputs/ during ad-hoc
# testing (screenshots, one-off .mtl/.csv checks) -- outputs/*/ subfolders
# are unaffected by this single-* glob.
outputs/*.png
outputs/*.mtl
outputs/*.csv
outputs/cockpit/*.bak
assets/

# App-test screenshots captured during manual QA passes -- large (60+ JPGs,
# 57MB), disposable, not source (2026-07-24).
archive/workflowScreenshots/

# Blender project files (2026-07-25) -- large binary assets (12-52MB each
# for the 3 already tracked before this rule), synced peer-to-peer via
# Syncthing between machines instead. Includes high-fidelity asset kit
# libraries (e.g. blender/park_amenities/) and .blend1 autosave backups.
*.blend
*.blend1

# Syncthing's own internal folder marker -- never project content
.stfolder/

# Syncthing conflict-copy artifacts (2026-07-23) -- e.g.
# app.sync-conflict-20260722-145331-5FAKSDB.py, produced automatically when
# two machines' Syncthing instances see a file change at close to the same
# time. Never intentional project content; a batch of 60 of these had
# accumulated untracked before this rule was added (quarantined to
# archive/_sync_conflicts_20260722/, not deleted).
*.sync-conflict-*

# LoRA training sets (2026-07-28, logic/lora_harvest.py) live at
# data/lora_datasets/ and need NO rule of their own -- the blanket `data/`
# rule above already covers them, which is correct for the ~200MB+ of
# harvested archival imagery (all re-downloadable from the manifest, none
# of it authored here).
#
# Worth knowing: that also means each set's manifest.json and
# ATTRIBUTION.md are untracked. They're small, and they're the provenance
# of what a model was trained on -- including the CC BY-SA credits that
# have to travel with any published render. If those should survive in git,
# they need to move out of data/, not be negated back in (git cannot
# re-include a file whose parent directory is excluded).

# LoRA decay series renders (2026-07-28, logic/lora_decay_series.py) --
# regenerable from series.json (which records base checkpoint, prompt,
# seed, sampler and every frame's LoRA), and a full run is dozens of 1024px
# PNGs plus two GIFs. The existing `outputs/*.png` rule above only matches
# the top level, so this subfolder needs its own.
outputs/lora_decay/

# Batch diagram export + precedent-comparison test runs (2026-08-18,
# batch_export_worker.py / run_batch_export.py) -- same "regenerable
# derived output" reasoning as the rest of this section. outputs/batchExport/
# alone was 120MB+ uncommitted.
outputs/batchExport/
outputs/precedent_comparison/
outputs/precedent_international_test/
